{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apber/generador-etiquetas-chile/esquema/ficha.schema.json",
  "title": "Ficha de producto",
  "description": "Un archivo por producto. Solo guarda lo que se escribe o se lee del proveedor; lo calculado (porción, sellos, eslogan, envasador y origen) no se guarda.",
  "type": "object",
  "required": ["formato", "id", "tipo", "estado", "nombre_producto", "presentaciones"],
  "additionalProperties": false,
  "properties": {
    "formato": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "tipo": { "enum": ["simple", "mezcla", "solo_gestion"] },
    "estado": { "enum": ["se_vende", "no_se_vende"] },
    "nombre_producto": { "type": "string", "minLength": 1, "description": "Arco inferior del medallón." },
    "descripcion": {
      "description": "Nombre del alimento (RSA art. 107 a). Frente, hasta 3 líneas.",
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "destacado": {
      "description": "Opcional. Frente, hasta 2 líneas (p. ej. TOSTADO, NO FRITO).",
      "type": "array", "maxItems": 2,
      "items": { "type": "string", "minLength": 1 }
    },
    "color_aro": {
      "description": "Color del aro en hexadecimal; null mientras no se elija.",
      "type": ["string", "null"], "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "presentaciones": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/presentacion" }
    },
    "composicion": { "$ref": "#/$defs/composicion" },
    "receta": { "$ref": "#/$defs/receta" },
    "nutricion": { "$ref": "#/$defs/nutricion" },
    "fuentes": {
      "type": "array",
      "items": { "$ref": "#/$defs/fuente" }
    },
    "alertas_confirmadas": {
      "description": "Decisiones del usuario sobre alertas (p. ej. imprimir sin un dato o quitar un sello automático), con fecha.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alerta", "decision", "fecha"],
        "additionalProperties": false,
        "properties": {
          "alerta": { "type": "string" },
          "decision": { "type": "string" },
          "fecha": { "type": "string", "format": "date" },
          "nota": { "type": "string" }
        }
      }
    },
    "notas": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "tipo": { "const": "simple" } } },
      "then": {
        "required": ["descripcion", "composicion", "nutricion", "fuentes"],
        "not": { "required": ["receta"] },
        "properties": {
          "composicion": { "required": ["ingredientes", "nombre_como_ingrediente", "contiene", "puede_contener", "anadidos", "pais_origen", "con_cascara"] },
          "nutricion": { "required": ["porcion", "por_100g"] }
        }
      }
    },
    {
      "if": { "properties": { "tipo": { "const": "mezcla" } } },
      "then": {
        "required": ["descripcion", "receta", "nutricion"],
        "properties": {
          "composicion": {
            "description": "En una mezcla, ingredientes, alérgenos, añadidos y origen salen de las fichas de los componentes.",
            "not": { "anyOf": [
              { "required": ["ingredientes"] }, { "required": ["contiene"] },
              { "required": ["puede_contener"] }, { "required": ["anadidos"] },
              { "required": ["pais_origen"] }
            ] }
          },
          "nutricion": { "required": ["porcion"], "not": { "required": ["por_100g"] } }
        }
      }
    },
    {
      "if": { "properties": { "tipo": { "const": "solo_gestion" } } },
      "then": { "not": { "anyOf": [{ "required": ["receta"] }, { "required": ["nutricion"] }] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "presentacion": {
      "type": "object",
      "required": ["peso_neto_g", "envase"],
      "additionalProperties": false,
      "properties": {
        "peso_neto_g": { "type": "number", "exclusiveMinimum": 0 },
        "envase": { "enum": ["sobre_chico", "sobre_kraft", "frasco", "otro"] },
        "codigo_barras": {
          "description": "EAN-13 completo (13 dígitos) asociado a esta presentación; null si no tiene.",
          "type": ["string", "null"], "pattern": "^[0-9]{13}$"
        },
        "origen_codigo": { "enum": ["propio", "corporacion", null] }
      }
    },
    "composicion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingredientes": {
          "description": "Texto en el orden del proveedor. Los alérgenos van entre llaves {…} y salen en negrita.",
          "type": ["string", "null"]
        },
        "nombre_como_ingrediente": {
          "description": "Nombre corto que usan las mezclas (p. ej. pasas rubias).",
          "type": "string"
        },
        "contiene": {
          "description": "Ids del catálogo de alérgenos; el principal primero. null = dato faltante.",
          "type": ["array", "null"], "uniqueItems": true,
          "items": { "type": "string" }
        },
        "puede_contener": {
          "description": "Ids del catálogo de alérgenos. null = dato faltante.",
          "type": ["array", "null"], "uniqueItems": true,
          "items": { "type": "string" }
        },
        "anadidos": {
          "description": "Lo que se adicionó (también dentro de un ingrediente comprado); define qué sellos se evalúan.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tipo", "ingrediente"],
            "additionalProperties": false,
            "properties": {
              "tipo": { "enum": ["azucar", "grasa", "sodio"] },
              "ingrediente": { "type": "string" }
            }
          }
        },
        "pais_origen": { "description": "null = dato faltante.", "type": ["string", "null"] },
        "con_cascara": { "description": "Si es true, la tabla es por parte comestible y lleva leyenda.", "type": "boolean" },
        "conservacion": { "description": "null = texto por defecto de la empresa.", "type": ["string", "null"] },
        "instrucciones_uso": { "type": ["string", "null"] },
        "texto_adicional": { "type": ["string", "null"] },
        "duracion_proveedor": {
          "description": "No se imprime.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["cantidad", "unidad"],
              "additionalProperties": false,
              "properties": {
                "cantidad": { "type": "integer", "minimum": 1 },
                "unidad": { "enum": ["dias", "meses", "anios"] }
              }
            }
          ]
        },
        "fuente": { "description": "Id de la fuente de la composición.", "type": "string" }
      }
    },
    "receta": {
      "type": "object",
      "required": ["componentes"],
      "additionalProperties": false,
      "properties": {
        "componentes": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object",
            "required": ["producto", "g_por_100g"],
            "additionalProperties": false,
            "properties": {
              "producto": { "$ref": "#/$defs/id" },
              "g_por_100g": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
              "alternativas": {
                "description": "Productos que pueden reemplazar a este al imprimir (el primero de la receta es el por defecto).",
                "type": "array", "items": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    },
    "nutricion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "porcion": {
          "type": "object",
          "required": ["g", "medida_casera"],
          "additionalProperties": false,
          "properties": {
            "g": { "type": "number", "exclusiveMinimum": 0 },
            "medida_casera": { "type": "string", "minLength": 1 },
            "fuente": { "type": "string" }
          }
        },
        "por_100g": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "energia_kcal": { "$ref": "#/$defs/valor" },
            "proteinas_g": { "$ref": "#/$defs/valor" },
            "grasas_totales_g": { "$ref": "#/$defs/valor" },
            "grasas_saturadas_g": { "$ref": "#/$defs/valor" },
            "grasas_monoinsaturadas_g": { "$ref": "#/$defs/valor" },
            "grasas_poliinsaturadas_g": { "$ref": "#/$defs/valor" },
            "grasas_trans_g": { "$ref": "#/$defs/valor" },
            "colesterol_mg": { "$ref": "#/$defs/valor" },
            "hidratos_carbono_disponibles_g": { "$ref": "#/$defs/valor" },
            "azucares_totales_g": { "$ref": "#/$defs/valor" },
            "fibra_dietetica_g": { "$ref": "#/$defs/valor" },
            "sodio_mg": { "$ref": "#/$defs/valor" }
          }
        }
      }
    },
    "valor": {
      "description": "Valor por 100 g y la fuente de donde salió. Si falta el dato, la clave no se incluye.",
      "type": "object",
      "required": ["valor", "fuente"],
      "additionalProperties": false,
      "properties": {
        "valor": { "type": "number", "minimum": 0 },
        "fuente": { "type": "string" }
      }
    },
    "fuente": {
      "type": "object",
      "required": ["id", "nivel", "tipo", "origen", "fecha"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "nivel": {
          "description": "1 proveedor; 2 etiqueta anterior de la empresa (coherente); 3 tabla reconocida (USDA); 4 referencia de mercado.",
          "enum": [1, 2, 3, 4]
        },
        "tipo": { "enum": ["foto_etiqueta", "captura_web", "ficha_tecnica", "etiqueta_anterior", "tabla_reconocida", "referencia_mercado", "manual"] },
        "origen": { "description": "Quién entrega el dato (proveedor, tabla o marca).", "type": "string" },
        "fecha": { "type": "string", "format": "date" },
        "archivos": { "description": "Rutas de las fotos o capturas en la carpeta del producto.", "type": "array", "items": { "type": "string" } },
        "enlace": { "type": "string" },
        "nota": { "type": "string" }
      }
    }
  }
}
