{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/apber/generador-etiquetas-chile/schema/product.schema.json",
  "title": "Product record",
  "description": "One file per product. Stores only what is typed in or read from the supplier; derived data (per-serving values, warning seals, slogan, packer and origin text) is computed, not stored.",
  "type": "object",
  "required": ["format_version", "id", "type", "status", "product_name", "presentations"],
  "additionalProperties": false,
  "properties": {
    "format_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "type": { "enum": ["simple", "mix", "management_only"] },
    "status": { "enum": ["active", "inactive"] },
    "product_name": { "type": "string", "minLength": 1, "description": "Lower arc of the medallion." },
    "description": {
      "description": "Food name (RSA art. 107 a). Front panel, up to 3 lines.",
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "highlight": {
      "description": "Optional. Front panel, usually 1-2 lines (e.g. TOSTADO, NO FRITO); 3 when needed (fit is checked on the label).",
      "type": "array", "maxItems": 3,
      "items": { "type": "string", "minLength": 1 }
    },
    "ring_color": {
      "description": "Medallion ring color as hex; null until chosen.",
      "type": ["string", "null"], "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "presentations": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/presentation" }
    },
    "composition": { "$ref": "#/$defs/composition" },
    "recipe": { "$ref": "#/$defs/recipe" },
    "nutrition": { "$ref": "#/$defs/nutrition" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "confirmed_alerts": {
      "description": "User decisions on alerts (e.g. print without a missing datum, remove an automatic seal), with date.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alert", "decision", "date"],
        "additionalProperties": false,
        "properties": {
          "alert": { "type": "string" },
          "decision": { "type": "string" },
          "date": { "type": "string", "format": "date" },
          "note": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" }
  },
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "simple" } } },
      "then": {
        "required": ["description", "composition", "nutrition", "sources"],
        "not": { "required": ["recipe"] },
        "properties": {
          "composition": { "required": ["ingredients", "name_as_ingredient", "contains", "may_contain", "added", "country_of_origin", "in_shell"] },
          "nutrition": { "required": ["serving", "per_100g"] }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "mix" } } },
      "then": {
        "required": ["description", "recipe", "nutrition"],
        "properties": {
          "composition": {
            "description": "In a mix, ingredients, allergens, added nutrients and origin come from the component records.",
            "not": { "anyOf": [
              { "required": ["ingredients"] }, { "required": ["contains"] },
              { "required": ["may_contain"] }, { "required": ["added"] },
              { "required": ["country_of_origin"] }
            ] }
          },
          "nutrition": { "required": ["serving"], "not": { "required": ["per_100g"] } }
        }
      }
    },
    {
      "if": { "properties": { "type": { "const": "management_only" } } },
      "then": { "not": { "anyOf": [{ "required": ["recipe"] }, { "required": ["nutrition"] }] } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "presentation": {
      "type": "object",
      "required": ["net_weight_g", "container"],
      "additionalProperties": false,
      "properties": {
        "net_weight_g": { "type": "number", "exclusiveMinimum": 0 },
        "container": { "enum": ["small_pouch", "kraft_pouch", "jar", "other"] },
        "barcode": {
          "description": "Full EAN-13 (13 digits) tied to this presentation; null if none.",
          "type": ["string", "null"], "pattern": "^[0-9]{13}$"
        },
        "barcode_source": { "enum": ["own", "third_party", null] }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ingredients": {
          "description": "Text in the supplier's order. Allergens go in braces {…} and print in bold.",
          "type": ["string", "null"]
        },
        "name_as_ingredient": {
          "description": "Short name used by mixes (e.g. pasas rubias).",
          "type": "string"
        },
        "contains": {
          "description": "Allergen catalog ids; main one first. null = missing datum.",
          "type": ["array", "null"], "uniqueItems": true,
          "items": { "type": "string" }
        },
        "may_contain": {
          "description": "Allergen catalog ids (cross-contact). null = missing datum.",
          "type": ["array", "null"], "uniqueItems": true,
          "items": { "type": "string" }
        },
        "added": {
          "description": "Added sugar, fat or sodium (also inside a purchased ingredient); decides which warning seals are evaluated.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nutrient", "ingredient"],
            "additionalProperties": false,
            "properties": {
              "nutrient": { "enum": ["sugar", "fat", "sodium"] },
              "ingredient": { "type": "string" }
            }
          }
        },
        "country_of_origin": { "description": "null = missing datum.", "type": ["string", "null"] },
        "in_shell": { "description": "If true, nutrition is per edible portion and the label adds a note.", "type": "boolean" },
        "storage": { "description": "null = company default text.", "type": ["string", "null"] },
        "usage_instructions": { "type": ["string", "null"] },
        "extra_text": { "type": ["string", "null"] },
        "supplier_shelf_life": {
          "description": "Not printed.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["amount", "unit"],
              "additionalProperties": false,
              "properties": {
                "amount": { "type": "integer", "minimum": 1 },
                "unit": { "enum": ["days", "months", "years"] }
              }
            }
          ]
        },
        "source": { "description": "Source id for the composition.", "type": "string" }
      }
    },
    "recipe": {
      "type": "object",
      "required": ["components"],
      "additionalProperties": false,
      "properties": {
        "components": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object",
            "required": ["product", "g_per_100g"],
            "additionalProperties": false,
            "properties": {
              "product": { "$ref": "#/$defs/id" },
              "g_per_100g": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
              "alternatives": {
                "description": "Products that may replace this one at print time (the recipe product is the default).",
                "type": "array", "items": { "$ref": "#/$defs/id" }
              }
            }
          }
        }
      }
    },
    "nutrition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "serving": {
          "type": "object",
          "required": ["g", "household_measure"],
          "additionalProperties": false,
          "properties": {
            "g": { "type": "number", "exclusiveMinimum": 0 },
            "household_measure": { "type": "string", "minLength": 1 },
            "source": { "type": "string" }
          }
        },
        "per_100g": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "energy_kcal": { "$ref": "#/$defs/value" },
            "protein_g": { "$ref": "#/$defs/value" },
            "total_fat_g": { "$ref": "#/$defs/value" },
            "saturated_fat_g": { "$ref": "#/$defs/value" },
            "monounsaturated_fat_g": { "$ref": "#/$defs/value" },
            "polyunsaturated_fat_g": { "$ref": "#/$defs/value" },
            "trans_fat_g": { "$ref": "#/$defs/value" },
            "cholesterol_mg": { "$ref": "#/$defs/value" },
            "available_carbohydrates_g": { "$ref": "#/$defs/value" },
            "total_sugars_g": { "$ref": "#/$defs/value" },
            "dietary_fiber_g": { "$ref": "#/$defs/value" },
            "sodium_mg": { "$ref": "#/$defs/value" }
          }
        }
      }
    },
    "value": {
      "description": "Value per 100 g and the source it came from. A missing datum is left out.",
      "type": "object",
      "required": ["value", "source"],
      "additionalProperties": false,
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "source": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "level", "kind", "from", "date"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "level": {
          "description": "1 supplier; 2 company's previous label (consistent); 3 reference table (e.g. USDA); 4 market reference (another brand).",
          "enum": [1, 2, 3, 4]
        },
        "kind": { "enum": ["label_photo", "web_capture", "technical_sheet", "previous_label", "reference_table", "market_reference", "manual"] },
        "from": { "description": "Who provides the data (supplier, table or brand).", "type": "string" },
        "date": { "type": "string", "format": "date" },
        "files": { "description": "Paths of photos or captures in the product folder.", "type": "array", "items": { "type": "string" } },
        "link": { "type": "string" },
        "note": { "type": "string" }
      }
    }
  }
}
